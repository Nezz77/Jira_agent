# ──────────────────────────────────────────────────────
#  Jira Agile Agent — Environment Variables Template
#  Copy this file to `.env` and fill in your values.
#  NEVER commit the actual `.env` file to version control.
# ──────────────────────────────────────────────────────

# ── Google Gemini ─────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Gemini model to use. gemini-3.6-flash is fast and capable.
# Options: gemini-3.6-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-3.6-flash

# ── Jira / Atlassian ──────────────────────────────────
# Your Atlassian domain (without https://)
# e.g. mycompany.atlassian.net
JIRA_DOMAIN=yourcompany.atlassian.net

# The email address you use to log into Jira
JIRA_EMAIL=you@example.com

# Generate an API token at:
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here

# Jira project key (e.g. PROJ, MYAPP).
# If the project does not exist, the agent will create it.
JIRA_PROJECT_KEY=PROJ

# Human-readable name for the Jira project
# (used only when creating a new project)
JIRA_PROJECT_NAME=My Project
