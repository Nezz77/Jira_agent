# ──────────────────────────────────────────────────────
#  Jira Agile Agent — Environment Variables Template
#  Copy this file to `.env` and fill in your values.
#  NEVER commit the actual `.env` file to version control.
# ──────────────────────────────────────────────────────

# ── Google Gemini (Primary AI) ────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_primary_gemini_api_key_here

# Optional: extra Gemini keys to rotate through when the primary key hits quota.
# Comma-separated list of API keys. The agent will try them in order on 429/503.
GEMINI_API_KEYS_EXTRA=your_second_key_here,your_third_key_here

# Gemini model to use as the primary model.
# Falls back through: gemini-3.6-flash → gemini-3.8-flash → gemini-3.5-flash-lite → deepseek-chat
# Options: gemini-3.6-flash, gemini-3.8-flash, gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.6-flash

# ── DeepSeek (Fallback AI) ────────────────────────────
# DeepSeek is used as a final fallback when all Gemini keys are exhausted.
# Get your key at: https://platform.deepseek.com/api_keys
# Leave blank to skip DeepSeek fallback.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ── Jira / Atlassian ──────────────────────────────────
# Your Atlassian domain (without https://)
# e.g. mycompany.atlassian.net
JIRA_DOMAIN=yourcompany.atlassian.net

# The email address you use to log into Jira
JIRA_EMAIL=you@example.com

# Generate an API token at:
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here

# Jira project key (e.g. PROJ, MYAPP).
# If the project does not exist, the agent will attempt to create it
# (requires 'Administer Jira' permission on your Atlassian account).
JIRA_PROJECT_KEY=PROJ

# Human-readable name for the Jira project
# (used only when creating a new project)
JIRA_PROJECT_NAME=My Project
